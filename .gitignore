# Superseded 2025 guides. Kept on disk for reference while the 2026 rewrite is in
# progress, but never published -- they contradict the current stack (Unity 2022.3,
# Oculus XR Plugin, GitHub Desktop password sign-in) and must not reach students.
Guides/Old/

# LaTeX build artefacts from the course guide
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# =============================================================================
# Unity -- applies to every Unity project nested anywhere in this repository
# (Week 02/, Week 03/, Lecture_Demos/, ...). Adapted from GitHub's maintained
# template: https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Patterns with no leading slash match at any depth, so the folder rules below
# catch nested projects automatically. Patterns that contain a slash are
# anchored to this file's directory, so those carry an explicit **/ prefix.
# =============================================================================

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity builds and exports
[Bb]uild/
[Bb]uilds/
[Ee]xports/

# Asset Store Tools plugin
**/[Aa]ssets/AssetStoreTools*

# Autogenerated Visual Studio / Rider / IDE files
.vs/
.idea/
.vscode/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity generated crash reports and diagnostics
sysinfo.txt
crashlytics-build.properties

# Unity build artefacts
*.apk
*.aab
*.app
*.xcodeproj
*.xcworkspace
*.ipa

# Gradle / Android generated files
.gradle/
**/gradleOut/
**/StreamingAssets/aa.meta
**/StreamingAssets/aa/*

# Test and coverage output
[Tt]est[Rr]esults/
[Cc]overage/

# Temporary office files
~$*.docx
~$*.xlsx
~$*.pptx

# Exported Unity packages and archives are build output, not source -- but
# course-supplied material is meant to be committed, so anything under a
# SuppliedAssets folder is kept. Rename that folder here if your course uses a
# different one.
*.unitypackage
*.zip
*.7z
*.rar
*.bak
*.backup
!**/[Ss]upplied[Aa]ssets/**

# Never ignore Unity .meta files when their matching asset is tracked.
!**/[Aa]ssets/**/*.meta

# Operating system files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
