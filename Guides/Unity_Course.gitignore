# Unity course repository .gitignore
# Supports multiple Unity projects nested anywhere in this repository.
# Adapted from GitHub's maintained Unity.gitignore template:
# https://github.com/github/gitignore/blob/main/Unity.gitignore

# -----------------------------------------------------------------------------
# Unity generated folders (recursive for Prototype1, Prototype2, Prototype3)
# -----------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity builds and exports
[Bb]uild/
[Bb]uilds/
[Ee]xports/

# Asset Store Tools plugin
[Aa]ssets/AssetStoreTools*

# Autogenerated Visual Studio / Rider / IDE files
.vs/
.idea/
.vscode/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity generated crash reports and diagnostics
sysinfo.txt
crashlytics-build.properties

# Unity build artefacts
*.apk
*.aab
*.app
*.xcodeproj
*.xcworkspace
*.ipa

# Exported Unity packages are build output, not source -- but course-supplied
# packages are meant to be committed, so anything under a SuppliedAssets folder
# is kept. Rename that folder here if your course uses a different one.
*.unitypackage
![Ss]upplied[Aa]ssets/**/*.unitypackage

# Gradle / Android generated files
.gradle/
**/gradleOut/
**/StreamingAssets/aa.meta
**/StreamingAssets/aa/*

# Test and coverage output
[Tt]est[Rr]esults/
[Cc]overage/

# Operating system files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

# Temporary office files
~$*.docx
~$*.xlsx
~$*.pptx

# Archives and local backups should not live in the repository.
# Exception: anything your tutor supplies under a SuppliedAssets folder is kept,
# so course-provided archives survive a commit.
*.zip
*.7z
*.rar
*.bak
*.backup
![Ss]upplied[Aa]ssets/**/*.zip

# Never ignore Unity .meta files when their matching asset is tracked.
![Aa]ssets/**/*.meta
